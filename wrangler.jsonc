{
  "name": "attendance-gathering",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/c/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attendance",
      // Replace with the id printed by `npx wrangler d1 create attendance`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
